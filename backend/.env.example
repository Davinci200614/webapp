APP_NAME=MACHINATI × Nouba
DB_PATH=webapp.db
CORS_ORIGINS=http://localhost:5173
META_VERIFY_TOKEN=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v23.0
# Public business contact number, including country code, without + or spaces.
WHATSAPP_CONTACT_NUMBER=
# Required for OpenAI text understanding and transcription.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TIMEOUT_SECONDS=45
# Optional Gemini provider; leave blank for OpenAI-only operation.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_STT_MODEL=
LLM_PROVIDER=openai
LLM_FALLBACK_PROVIDER=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
CONVERSATION_CORE=v2
CONVERSATION_PROVIDER=openai
CONVERSATION_ENABLED=true
# Leave blank to use OPENAI_MODEL for OpenAI conversation understanding.
CONVERSATION_MODEL=
# Leave unset to inherit GEMINI_MODEL, or set a separate compatible text model.
CONVERSATION_GEMINI_MODEL=
CONVERSATION_THINKING_LEVEL=minimal
CONVERSATION_TIMEOUT_SECONDS=15
OLLAMA_TIMEOUT_SECONDS=35
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=300
OLLAMA_KEEP_ALIVE=2m
STT_PROVIDER=openai
AUTH_BOOTSTRAP_EMAIL=hamid@gmail.com
AUTH_BOOTSTRAP_PASSWORD=hamid
AUTH_SESSION_TTL_HOURS=12
# Optional compatibility keys; session login is preferred.
OPERATOR_API_KEY=
ADMIN_API_KEY=
MUTATIONS_ENABLED=true
# Admin session is also required for all inspection routes.
INSPECTOR_ENABLED=false

# Use AI for conversational text; rules_first keeps the previous routing.
CONVERSATION_ROUTING=model_first
# Model-written conversational replies after validated outcomes. Summaries stay exact.
CONVERSATION_REPLY_STYLE=model
CONVERSATION_REPLY_TIMEOUT_SECONDS=4
# Example cooperative checklist; semicolon-separated, editable; not legal requirements.
DOCUMENT_CHECKLIST=ملخص طلب الخدمة (الاسم، المكان، نوع الخدمة والتاريخ);تصريح بطبيعة الأشغال ومكانها;وثيقة تمثيل التعاونية إذا كان الطلب باسمها، عند الاقتضاء;وثيقة استغلال الأرض لطلب المعدات، عند الاقتضاء
# Approved Meta template with two body parameters: request ID, notification text.
WHATSAPP_DOCUMENT_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=ar

# Public presentation only: open operator/admin pages without login.
PUBLIC_DEMO_MODE=false
